{
  "expo": {
    "name": "AutoLedger",
    "slug": "autoledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.autoledger.app",
      "permissions": [
        "READ_SMS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3730A3"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BizPilot to detect your location so it can be recorded with each trip payment."
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-secure-store"
    ]
  }
}
